{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
    },
    "include": [
        "packages/cplint/src/**/*",
        "packages/adapter-angular/src/**/*",
        "packages/adapter-react/src/**/*",
        "packages/adapter-node/src/**/*"
    ]
}
