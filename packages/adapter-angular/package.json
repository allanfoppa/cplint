{
  "name": "@cplint/adapter-angular",
  "version": "0.1.0",
  "description": "Angular framework adapter for CPLint.",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["cplint", "angular", "adapter", "typescript", "linting"],
  "author": "Allan Foppa Fagundes <allanfoppa.dev@gmail.com>",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "cplint": "workspace:*",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}