{
  "name": "cplint",
  "version": "0.0.0",
  "author": "Allan Foppa Fagundes <allanfoppa.dev@gmail.com>",
  "description": "AST-based semantic linting and context optimization tooling for AI-assisted development.",
  "keywords": [
    "ast",
    "typescript",
    "semantic-analysis",
    "llm",
    "ai",
    "context-engineering",
    "token-optimization",
    "vertical-slice",
    "architecture",
    "co-location",
    "developer-tools"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "cplint": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsdown",
    "test": "vitest",
    "start": "node dist/main.js",
    "prepublishOnly": "pnpm run build"
  },
  "packageManager": "pnpm@11.0.9",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
