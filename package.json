{
  "name": "cplint-monorepo",
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:exports": "pnpm -r --parallel exec publint",
    "lint:deps": "dependency-cruiser --config .dependency-cruiser.cjs packages",
    "buildTokenTemplate": "node scripts/compile-templates.js",
    "build": "pnpm --filter cplint run build && pnpm --filter \"@cplint/adapter-*\" run build && pnpm typecheck && pnpm lint:exports && pnpm lint:deps && pnpm buildTokenTemplate"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=11.0.9"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "dependency-cruiser": "^17.4.3",
    "publint": "^0.3.21",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  }
}
